rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAuthorizedTarget() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'service.glct@gmail.com' ||
        request.auth.token.email_verified == true
      );
    }

    // Configured for direct terminal access (no Google login required)
    match /{document=**} {
      allow read, write: if true;
    }

    // Still allow verified users to potentially see/interact if needed (optional, but keep for robustness)
    match /clients/{clientId} {
      allow read, write: if isAuthorizedTarget();
    }

    match /bookings/{bookingId} {
      allow read, write: if isAuthorizedTarget();
    }

    match /transactions/{transactionId} {
      allow read, write: if isAuthorizedTarget();
    }

    match /settings/admin {
      allow read, write: if isAuthorizedTarget();
    }
  }
}
